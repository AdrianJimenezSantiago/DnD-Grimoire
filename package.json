{
  "name": "grimorio",
  "version": "2.3.0",
  "private": true,
  "description": "Hoja de personaje y libro de conjuros de D&D 2024 para Android, Windows y web",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:cobertura": "node --test --experimental-test-coverage --test-coverage-include=\"web/src/domain/**\" --test-coverage-include=\"web/src/core/**\" --test-coverage-include=\"web/src/platform/archivosWeb.js\" --test-coverage-lines=94 --test-coverage-branches=80 --test-coverage-functions=85 \"tests/**/*.test.js\"",
    "e2e": "PERSONAJES_PRUEBA=0 vite build --config web/vite.config.js && node --test --test-concurrency=1 --test-timeout=60000 \"e2e/**/*.e2e.js\"",
    "sync": "npm run build && cap sync android",
    "icons": "python3 tools/iconos/make_icons.py",
    "srd": "python3 tools/compendio/build_compendio.py",
    "build:windows": "vite build --config web/vite.config.js --mode windows && node tools/renombrar-windows.mjs",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "@fontsource/cinzel": "5.3.0",
    "@fontsource/cinzel-decorative": "5.3.0",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@iconify-json/game-icons": "^1.2.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "1.64.1",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module"
}
