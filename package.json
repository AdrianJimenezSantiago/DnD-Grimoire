{
  "name": "grimorio",
  "version": "2.0.0",
  "private": true,
  "description": "Grimorio de Theo como app de Android (Capacitor)",
  "scripts": {
    "dev": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "preview": "vite preview --config web/vite.config.js",
    "test": "node --test \"tests/*.test.js\"",
    "sync": "npm run build && cap sync android",
    "icons": "python3 tools/make_icons.py",
    "srd": "python3 tools/build_srd.py",
    "build:windows": "vite build --config web/vite.config.js --mode windows && node tools/renombrar-windows.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.2",
    "@fontsource/alegreya": "5.3.0",
    "@fontsource/alegreya-sans": "5.3.0",
    "pdfjs-dist": "^5.7.284"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@iconify-json/game-icons": "^1.2.4",
    "vite": "^7.3.6",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "type": "module"
}
